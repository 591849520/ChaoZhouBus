# ═════════════════════════════════════════════════════════════════════
# ChaoZhouBus (高校潮州同乡会大巴智能系统) 生产环境配置模板
# 复制本文件为 .env.production 并根据实际生产环境填入真实密钥：
#   cp deploy/.env.production.example deploy/.env.production
# ═════════════════════════════════════════════════════════════════════

# 1. 基础服务网络配置
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# 2. SQLite 数据库与持久化配置
# 推荐使用相对路径挂载或绝对路径，确保宿主机目录具备可写权限
SQLITE_DB_PATH=data/chaozhoubus.db

# 3. 管理端凭证与安全 Token (请务必在生产环境生成高强度随机密钥)
# 例如使用命令生成：openssl rand -hex 32
ADMIN_SECRET_TOKEN=chaozhou_admin_prod_secret_token_2026_please_change_me

# 4. 业务规则配置 (严禁硬编码)
# 锁座保留秒数（300 秒 = 5 分钟，严格对齐微信支付 time_expire）
LOCK_TTL_SECONDS=300
# 单用户单班次限购座位数
MAX_SEATS_PER_USER=2
# 大巴车模默认总座位数 (固定 53 座双侧过道 + 尾排 5 连座)
DEFAULT_TOTAL_SEATS=53
# 默认预留领队/物资座位编号（逗号分隔）
DEFAULT_RESERVED_SEATS=01,02

# 5. 阶梯退票规则配置
# 规则一：发车前 >= 48 小时，手续费 5%
REFUND_TIER1_HOURS=48
REFUND_TIER1_FEE_PCT=5
# 规则二：发车前 24 ~ 48 小时，手续费 20%
REFUND_TIER2_HOURS=24
REFUND_TIER2_FEE_PCT=20
# （小于 24 小时系统自动拦截，禁止自助退票）

# 6. 微信小程序与微信支付 APIv3 (上线前配置)
# 是否启用 Mock 支付模拟测试（本地/预发布为 true；正式生产设为 false）
WX_PAY_MOCK=false
# 小程序 AppID 与 AppSecret
WX_APP_ID=wx_production_app_id
WX_APP_SECRET=wx_production_app_secret_key
# 微信支付商户号 (MCH ID)
WX_MCH_ID=1900000000
# 微信支付商户 API 证书序列号
WX_CERT_SERIAL_NO=1DDE55...
# 微信支付 APIv3 密钥 (32 位字符串)
WX_API_V3_KEY=32_char_api_v3_key_here
# 微信支付商户私钥文件路径 (.pem)
WX_PRIVATE_KEY_PATH=/app/server/certs/apiclient_key.pem

# 7. 日志与备份持久化
ENABLE_FILE_LOGGING=true
LOG_FILE_PATH=logs/server.log
# 备份清理保留天数（默认 7 天）
BACKUP_RETENTION_DAYS=7

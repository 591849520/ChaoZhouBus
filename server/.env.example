# Server Configuration
PORT=3000
HOST=0.0.0.0
SQLITE_DB_PATH=./data/chaozhou_bus.db

# Seat Lock & Quota Rules
LOCK_TTL_SECONDS=300
MAX_SEATS_PER_USER=2
DEFAULT_TOTAL_SEATS=53
DEFAULT_RESERVED_SEATS=01,02

# Tiered Refund Rules (Default)
REFUND_TIER1_HOURS=48
REFUND_TIER1_FEE_PCT=5
REFUND_TIER2_HOURS=24
REFUND_TIER2_FEE_PCT=20

# Admin Token (for local & admin dashboard authentication)
ADMIN_SECRET_TOKEN=chaozhou_admin_dev_token_change_in_prod

# WeChat Pay APIv3 (Set WX_PAY_MOCK=true for local development without real merchant credentials)
WX_PAY_MOCK=true
WX_APPID=wx_mock_appid
WX_MCHID=1900000000
WX_APIV3_KEY=mock_32_byte_apiv3_key_for_dev_00
WX_SERIAL_NO=mock_cert_serial_no

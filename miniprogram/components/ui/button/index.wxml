<view
  class="ui-btn ui-btn--{{variant}} ui-btn--{{size}} {{block ? 'ui-btn--block' : ''}} {{(disabled || loading || isCoolingDown) ? 'ui-btn--disabled' : ''}}"
  bindtap="handleTap"
>
  <view wx:if="{{loading || isCoolingDown}}" class="ui-btn__spinner"></view>
  <text wx:if="{{text}}">{{text}}</text>
  <slot wx:else></slot>
</view>

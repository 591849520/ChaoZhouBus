<view class="ui-tabs ui-tabs--{{variant}}">
  <block wx:for="{{options}}" wx:key="value">
    <view
      class="ui-tabs__item {{value === item.value ? 'ui-tabs__item--active' : ''}}"
      data-value="{{item.value}}"
      bindtap="handleSelect"
    >
      <text class="ui-tabs__label">{{item.label}}</text>
      <text wx:if="{{item.count !== undefined}}" class="ui-tabs__count">({{item.count}})</text>
    </view>
  </block>
</view>

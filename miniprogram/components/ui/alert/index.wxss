.ui-alert {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 26rpx;
  border-radius: var(--radius-lg, 20rpx);
  border: 2rpx solid var(--border, #E4E4E7);
  background-color: var(--card, #FFFFFF);
  box-sizing: border-box;
  gap: 20rpx;
}

.ui-alert--default {
  background-color: #F8FAFC;
  border-color: #E2E8F0;
  color: #0F172A;
}

.ui-alert--warning {
  background-color: #FFFBEB;
  border-color: #FDE68A;
  color: #92400E;
}

.ui-alert--destructive {
  background-color: #FEF2F2;
  border-color: #FECACA;
  color: #991B1B;
}

.ui-alert--success {
  background-color: #F0FDF4;
  border-color: #BBF7D0;
  color: #166534;
}

.ui-alert__content {
  flex: 1;
}

.ui-alert__title {
  font-size: 26rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.ui-alert__desc {
  font-size: 23rpx;
  opacity: 0.9;
  line-height: 1.45;
}

.ui-alert__action {
  padding: 10rpx 20rpx;
  border-radius: var(--radius-full, 9999rpx);
  background-color: rgba(255, 255, 255, 0.88);
  font-size: 23rpx;
  font-weight: 600;
  white-space: nowrap;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
}

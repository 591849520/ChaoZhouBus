.alert-wrapper {
  margin-bottom: 24rpx;
}

.meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 25rpx;
}

.meta-label {
  color: var(--muted-fg, #71717A);
}

.meta-val {
  color: var(--fg, #09090B);
  font-weight: 600;
}

.meta-val--price {
  color: #0F766E;
  font-size: 28rpx;
  font-weight: 700;
}

.pay-action-box {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border, #E4E4E7);
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--fg, #09090B);
  margin: 16rpx 6rpx 18rpx;
}

.ticket-route-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background-color: #F8FAFC;
  border-radius: 16rpx;
  border: 1rpx solid #E2E8F0;
}

.station-col {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.station-col--right {
  text-align: right;
}

.station-tag {
  font-size: 21rpx;
  color: var(--muted-fg, #71717A);
}

.station-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #0F172A;
}

.route-arrow {
  font-size: 32rpx;
  color: var(--brand, #0D9488);
  font-weight: 700;
}

.checkin-code-panel {
  margin-top: 22rpx;
  padding: 24rpx;
  background-color: #F0FDFA;
  border: 2rpx dashed #5EEAD4;
  border-radius: 20rpx;
  text-align: center;
}

.code-caption {
  font-size: 22rpx;
  color: #0F766E;
  font-weight: 600;
}

.six-digit-code {
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: 12rpx;
  color: #0F766E;
  margin: 12rpx 0;
  font-family: monospace;
}

.qr-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 10rpx;
}

.qr-canvas {
  width: 240rpx;
  height: 240rpx;
  background-color: #FFFFFF;
  padding: 12rpx;
  border-radius: 16rpx;
  border: 2rpx solid #CCFBF1;
}

.qr-payload-hint {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #64748B;
  font-family: monospace;
}

.checked-time-note {
  margin-top: 16rpx;
  font-size: 23rpx;
  font-weight: 600;
  color: #166534;
}

.refund-preview-row {
  display: flex;
  justify-content: space-between;
  font-size: 25rpx;
  padding: 8rpx 0;
}

.refund-tier-text {
  font-weight: 600;
  color: var(--fg, #09090B);
}

.refund-back-price {
  font-weight: 700;
  color: #0F766E;
}

.footer-nav {
  margin-top: 20rpx;
}
